# API 이미지 — 빌드 컨텍스트는 저장소 루트 (db/migrations 를 함께 담기 위해)
FROM python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    ATLAS_MIGRATIONS_DIR=/app/db/migrations ATLAS_SEED_DIR=/app/seed
WORKDIR /app
COPY atlas/pyproject.toml atlas/pyproject.toml
COPY atlas/atlas atlas/atlas
RUN pip install ./atlas
COPY db/migrations db/migrations
COPY seed seed
EXPOSE 8100
CMD ["uvicorn", "atlas.api.main:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "2", "--no-access-log"]
