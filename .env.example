# =============================================================================
# .env.example — 우체국 접근성 아틀라스 (값은 비워 둔 채 커밋)
#   cp .env.example .env   후 키 값을 채우세요. (.env 는 .gitignore 대상)
#   make up 은 .env 가 없으면 이 파일을 복사해 만들어 줍니다.
# =============================================================================

# ---- 외부 API 키 (서버에서만 사용) ----
# 공공데이터포털 일반 인증키 (Decoding 키 권장)
POST_SERVICE_KEY=
# SGIS 서비스 ID
SGIS_CONSUMER_KEY=
# SGIS 보안 Key
SGIS_CONSUMER_SECRET=
# (선택) 카카오 REST API 키 — 도로 거리(모빌리티)·은행 지점·주소 좌표 검증(로컬)
KAKAO_REST_API_KEY=
# (선택) KOSIS 공유서비스 사용자 인증키 — 65세 이상 주민등록인구(고령인구 지표·What-if 영향 고령인구)
KOSIS_API_KEY=
# (선택) 공공데이터포털 일반 인증키(Decoding) — 기상청 단기예보·에어코리아 대기오염정보 활용신청 후. 방문 여건 화면
DATA_GO_KR_KEY=

# ---- 브라우저에 노출되는 유일한 키 ----
# 카카오 JavaScript 키 (플랫폼 도메인: http://localhost:3100)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ---- 관리 API 보호 토큰 (수집·계산 트리거). make up 이 비어 있으면 자동 생성 ----
ADMIN_TOKEN=

# ---- 수집·계산 파라미터 ----
# SGIS 통계·경계 연도 (주요지표는 2015~2024)
STAT_YEAR=2024
# all 또는 쉼표 목록 (예: 11,41) — 적재할 시도
SGIS_SIDO=all
# 2=시군구, 3=읍면동
SGIS_LEVELS=2,3
# 우체국 API 호출 간 지연 (한도 미기재 → 보수적으로)
POST_CALL_DELAY_MS=300
# KOSIS 기준월 YYYYMM. 비우면 {STAT_YEAR}12(경계 연도와 맞춤), latest 면 최신월
KOSIS_PERIOD=
# 도로 거리 수집 1회 호출 예산 (다시 실행하면 이어서) · 카카오 호출 간 지연(ms)
ROAD_MAX_CALLS=8000
KAKAO_CALL_DELAY_MS=60

# ---- 호스트(맥)에서 직접 개발할 때 쓰는 접속 정보 ----
# (docker compose 안에서는 compose 파일이 컨테이너 주소로 덮어씁니다)
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5442/atlas
REDIS_URL=redis://localhost:6389/0
