# 비밀값 — 절대 커밋하지 않습니다
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Node / Next.js
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/playwright-report/
web/test-results/

# 스모크 테스트에서 받은 실제 응답은 키가 섞일 수 있어 기본은 제외합니다.
# 계약 테스트용으로 정제한 파일은 atlas/tests/contract/fixtures/ 에 둡니다.
fixtures/*
!fixtures/.gitkeep

# DB 백업 (make backup)
backups/

.DS_Store
*.tsbuildinfo
